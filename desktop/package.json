{
  "name": "centenaryo-desktop",
  "version": "1.0.0",
  "description": "Desktop Application wrapper for CENTENARYO",
  "main": "main.js",
  "author": "CENTENARYO LGU",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.centenaryo.app",
    "productName": "CENTENARYO",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CENTENARYO"
    },
    "directories": {
      "output": "dist"
    }
  }
}
